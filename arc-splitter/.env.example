# Copy to .env and fill in real values. Never commit the filled-in .env.

# Supabase — project URL and anon/public key.
# Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=

# Privy app ID — powers email + wallet login.
# https://dashboard.privy.io → your app → App ID
VITE_PRIVY_APP_ID=

# Arc Testnet JSON-RPC endpoint.
VITE_ARC_RPC_URL=https://rpc.testnet.arc.network
